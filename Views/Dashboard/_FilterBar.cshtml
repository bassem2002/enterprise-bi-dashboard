<section class="filter-bar" aria-label="Filtres globaux">
    <div class="filter-header">
        <div>
            <p class="section-kicker">Filtres globaux</p>
            <h2>Segmenter l'analyse</h2>
        </div>
        <button id="resetFilters" class="btn btn-sm btn-outline-light" type="button">Reinitialiser</button>
    </div>
    <div class="filter-grid">
        <label>
            <span>Annee</span>
            <select id="filterYear" class="form-select dashboard-filter" data-filter="year">
                <option value="">Toutes</option>
            </select>
        </label>
        <label>
            <span>Mois</span>
            <select id="filterMonth" class="form-select dashboard-filter" data-filter="month">
                <option value="">Tous</option>
            </select>
        </label>
        <label>
            <span>Produit</span>
            <select id="filterProduct" class="form-select dashboard-filter" data-filter="product">
                <option value="">Tous</option>
            </select>
        </label>
        <label>
            <span>Client</span>
            <select id="filterCustomer" class="form-select dashboard-filter" data-filter="customer">
                <option value="">Tous</option>
            </select>
        </label>
        <label>
            <span>Fournisseur</span>
            <select id="filterSupplier" class="form-select dashboard-filter" data-filter="supplier">
                <option value="">Tous</option>
            </select>
        </label>
        <label>
            <span>Pays client</span>
            <select id="filterCountry" class="form-select dashboard-filter" data-filter="country">
                <option value="">Tous</option>
            </select>
        </label>
    </div>
</section>
