@{
    var activeMenu = Convert.ToString(ViewData["ActiveMenu"]) ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise BI Dashboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnterpriseBIDashboard.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="sidebar-brand" asp-controller="Dashboard" asp-action="Index">
                <span class="brand-mark">BI</span>
                <span>
                    <strong>Enterprise</strong>
                    <small>Analytics Suite</small>
                </span>
            </a>
            <nav class="sidebar-nav" aria-label="Navigation principale">
                <a class="sidebar-link @(activeMenu == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><span>Overview</span></a>
                <a class="sidebar-link @(activeMenu == "Sales" ? "active" : "")" asp-controller="Dashboard" asp-action="SalesAnalytics"><span>Sales Analytics</span></a>
                <a class="sidebar-link @(activeMenu == "Purchases" ? "active" : "")" asp-controller="Dashboard" asp-action="PurchasesAnalytics"><span>Purchases Analytics</span></a>
                <a class="sidebar-link @(activeMenu == "Products" ? "active" : "")" asp-controller="Dashboard" asp-action="ProductsAnalytics"><span>Products Analytics</span></a>
                <a class="sidebar-link @(activeMenu == "Customers" ? "active" : "")" asp-controller="Dashboard" asp-action="CustomersAnalytics"><span>Customers Analytics</span></a>
                <a class="sidebar-link @(activeMenu == "Suppliers" ? "active" : "")" asp-controller="Dashboard" asp-action="SuppliersAnalytics"><span>Suppliers Analytics</span></a>
                <a class="sidebar-link @(activeMenu == "Executive" ? "active" : "")" asp-controller="Dashboard" asp-action="ExecutiveSummary"><span>Executive Summary</span></a>
            </nav>
        </aside>

        <div class="content-shell">
            <header class="topbar navbar navbar-light">
                <div>
                    <p class="topbar-kicker">EnterpriseDW / EnterpriseCube</p>
                    <h1>@(ViewData["PageHeading"] ?? "Dashboard BI")</h1>
                </div>
                <div class="topbar-actions">
                    <span id="lastRefresh" class="refresh-stamp">En attente</span>
                    <span id="connectionStatus" class="connection-pill pending">Verification cube...</span>
                    <button id="refreshDashboard" class="refresh-button" type="button" aria-label="Rafraichir les donnees">↻</button>
                    <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNavigation" aria-controls="mobileNavigation" aria-expanded="false" aria-label="Afficher la navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
            </header>

            <div class="collapse mobile-nav" id="mobileNavigation">
                <div class="mobile-nav-inner">
                    <a class="sidebar-link @(activeMenu == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">Overview</a>
                    <a class="sidebar-link @(activeMenu == "Sales" ? "active" : "")" asp-controller="Dashboard" asp-action="SalesAnalytics">Sales Analytics</a>
                    <a class="sidebar-link @(activeMenu == "Purchases" ? "active" : "")" asp-controller="Dashboard" asp-action="PurchasesAnalytics">Purchases Analytics</a>
                    <a class="sidebar-link @(activeMenu == "Products" ? "active" : "")" asp-controller="Dashboard" asp-action="ProductsAnalytics">Products Analytics</a>
                    <a class="sidebar-link @(activeMenu == "Customers" ? "active" : "")" asp-controller="Dashboard" asp-action="CustomersAnalytics">Customers Analytics</a>
                    <a class="sidebar-link @(activeMenu == "Suppliers" ? "active" : "")" asp-controller="Dashboard" asp-action="SuppliersAnalytics">Suppliers Analytics</a>
                    <a class="sidebar-link @(activeMenu == "Executive" ? "active" : "")" asp-controller="Dashboard" asp-action="ExecutiveSummary">Executive Summary</a>
                </div>
            </div>

            <main role="main" class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
